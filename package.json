{
  "name": "dashboard",
  "version": "1.2.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "vite build",
    "dev:client": "vite",
    "dev:no-poll": "concurrently --kill-others --names server,client \"pnpm run dev:server:no-poll\" \"pnpm run dev:client\"",
    "dev:server:no-poll": "node --watch src/server/index.ts no-poll",
    "dev:server": "node --watch src/server/index.ts",
    "dev": "concurrently --kill-others --names server,client \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "host-forever": "pnpm run build && pnpm run serve-forever",
    "host": "pnpm run build && pnpm run serve",
    "serve-forever": "NODE_ENV=production forever start -c node ./src/server/index.ts",
    "serve": "NODE_ENV=production node src/server/index.ts",
    "ts:dev:no-poll": "node src/server/index.ts no-poll",
    "ts:dev": "node src/server/index.ts",
    "tsc": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.server.json --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.1.0",
    "@emotion/is-prop-valid": "^1.3.1",
    "axios": "^1.21.1",
    "axios-retry": "^4.5.0",
    "cie-rgb-color-converter": "^1.0.6",
    "dayjs": "^1.11.13",
    "express": "^5.3.0",
    "ical-expander": "^3.1.0",
    "icloud-shared-album": "^1.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "styled-components": "^6.6.0",
    "styled-reset": "^5.0.0",
    "styles": "^0.2.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/socket.io": "^3.0.2",
    "@types/socket.io-client": "^3.0.0",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  }
}
